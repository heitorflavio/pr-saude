APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Assina o sufixo de verificacao do token de pulseira (doc 8.2.1).
# ATENCAO: nunca rotacionar em producao -- invalidaria todas as pulseiras ja
# impressas de uma vez (RN-03). Gere com: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
PULSEIRA_KEY=
APP_URL=https://pr-saude.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# O SGH exige MySQL 8.0.16+: as 18 restricoes CHECK, a coluna gerada
# atendimento.ativo_key (RN-07/D-07) e as views com ROW_NUMBER nao existem em SQLite.
# Ver docs/DECISOES.md D-04.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=prsaude
DB_USERNAME=root
DB_PASSWORD=

# Conta administrativa criada pelo UsuarioAdministradorSeeder -- a unica forma de
# entrar no sistema apos migrate:fresh, ja que o cadastro publico foi removido (D-18).
# A senha nasce provisoria e precisa ser trocada no primeiro acesso (RN-06).
ADMIN_LOGIN=admin
ADMIN_EMAIL=admin@pr-saude.test
ADMIN_SENHA=trocar-esta-senha

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
